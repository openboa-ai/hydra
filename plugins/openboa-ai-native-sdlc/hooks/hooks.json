{
  "description": "Read-only OpenBoa lifecycle diagnostics at session start and after compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/local/bin python3 -I \"${PLUGIN_ROOT}/skills/openboa-ai-native-sdlc/scripts/doctor.py\" --hook",
            "timeout": 5,
            "statusMessage": "Checking OpenBoa work context",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/local/bin python3 -I \"${PLUGIN_ROOT}/skills/openboa-ai-native-sdlc/scripts/doctor.py\" --hook",
            "timeout": 5,
            "statusMessage": "Rechecking OpenBoa work context"
          }
        ]
      }
    ]
  }
}
