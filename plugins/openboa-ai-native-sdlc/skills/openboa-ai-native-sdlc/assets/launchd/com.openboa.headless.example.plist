<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openboa.headless.example</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/ABSOLUTE/PLUGIN/skills/openboa-ai-native-sdlc/scripts/run_headless.py</string>
    <string>--project</string><string>/ABSOLUTE/CLEAN/WORKTREE</string>
    <string>--prompt</string><string>/ABSOLUTE/PROMPTS/outcome-health.md</string>
    <string>--state-dir</string><string>/ABSOLUTE/PRIVATE/STATE</string>
    <string>--job</string><string>outcome-health</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>17</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
