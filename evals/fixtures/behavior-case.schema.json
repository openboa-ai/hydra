{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openboa.ai/evals/behavior-case-v2.schema.json",
  "title": "OpenBoa decision-policy behavior case v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "scenario",
    "evaluation_kind",
    "input",
    "fixture",
    "evaluator"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scenario": {
      "type": "string",
      "pattern": "^\\.\\./scenarios/[^/]+\\.md$"
    },
    "evaluation_kind": {
      "const": "codex-decision-policy"
    },
    "input": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "sandbox", "tools", "github", "network"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "sandbox": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "tools": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "github": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "network": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "required_fields",
        "method_fields",
        "required_actions",
        "forbidden_actions",
        "required_observations",
        "required_unknowns"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "required_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario_id", "skill", "human_gate"],
          "properties": {
            "scenario_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "skill": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "human_gate": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        "method_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playbook", "decision"],
          "properties": {
            "playbook": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "decision": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        "required_actions": {
          "$ref": "#/$defs/stringArray"
        },
        "forbidden_actions": {
          "$ref": "#/$defs/stringArray"
        },
        "required_observations": {
          "$ref": "#/$defs/stringArray"
        },
        "required_unknowns": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  }
}
